EJERCICIO PARA SUBIR AL ONE-NOTES  
 
Se desea crear un sistema con base de datos para controlar los préstamos y devoluciones de libros en una biblioteca 
 
CREATE USER BIBLIOTECA IDENTIFIED BY BIBLIOTECA123; 
GRANT CONNECT, RESOURCE, UNLIMITED TABLESPACE TO BIBLIOTECA; 
 
 
 
CREACIÓN DE TABLAS  
 
 
CREATE TABLE BIBLIOTECARIOS ( 
    ID_BIB VARCHAR(10) PRIMARY KEY, 
    NOM_BIB VARCHAR(10) NOT NULL, 
    APE_BIB VARCHAR(10) NOT NULL, 
    SUE_BIB NUMBER NOT NULL 
); 
 
CREATE TABLE ESTUDIANTES ( 
    ID_EST VARCHAR(10) PRIMARY KEY, 
    NOM_EST VARCHAR(10) NOT NULL, 
    APE_EST VARCHAR(10) NOT NULL, 
    COR_EST VARCHAR(20) NOT NULL, 
    CAR_PER VARCHAR(10) NOT NULL, 
    HABILITADO CHAR(1) NOT NULL 
); 
 
CREATE TABLE LIBROS ( 
    ID_LIB VARCHAR(10) PRIMARY KEY, 
    NOM_LIB VARCHAR(10) NOT NULL, 
    CAN_PAGS_LIB NUMBER NOT NULL, 
    DISP_LIB CHAR(1) NOT NULL, 
    EST_LIB VARCHAR(10) NOT NULL, 
    CAN_DIAS NUMBER(1) NOT NULL 
); 
 
 
CREATE TABLE PRESTAMOS ( 
    NUM_PRE NUMBER PRIMARY KEY, 
    FEC_PRE DATE NOT NULL, 
    ID_BIB_PRE VARCHAR(10) NOT NULL REFERENCES BIBLIOTECARIOS(ID_BIB), 
    ID_EST_PRE VARCHAR(10) NOT NULL REFERENCES ESTUDIANTES(ID_EST), 
    ID_LIB_PRE VARCHAR(10) NOT NULL REFERENCES LIBROS(ID_LIB), 
    EST_PRE VARCHAR(10) NOT NULL, 
    ID_BIB_DEV VARCHAR(10) REFERENCES BIBLIOTECARIOS(ID_BIB), 
    FEC_DEV DATE, 
    EST_DEV VARCHAR(10) 
); 
 
CREATE TABLE MULTAS ( 
    NUM_MUL NUMBER PRIMARY KEY, 
    FEC_MUL DATE NOT NULL, 
    NUM_PRE_CAR NUMBER NOT NULL REFERENCES PRESTAMOS(NUM_PRE), 
    VALOR_MUL NUMBER NOT NULL, 
    ESTADO_MUL VARCHAR(5) 
); 
 
