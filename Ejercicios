TRIGGER PARA CONTROLAR LA ANOMALIA DE INSERCION EN PRESTAMOS. 
 
CREATE OR REPLACE TRIGGER CTROL_INS_EST_PRE 
BEFORE INSERT OR UPDATE OF ID_EST_PRE ON PRESTAMOS 
FOR EACH ROW 
DECLARE 
    D INTEGER; 
    ERROR_ID_EST_PRE EXCEPTION; 
BEGIN 
    SELECT COUNT(ID_EST) INTO D 
    FROM ESTUDIANTES 
    WHERE ID_EST = :NEW.ID_EST_PRE; 
 
    IF D = 0 THEN 
        RAISE ERROR_ID_EST_PRE; 
    END IF; 
 
EXCEPTION 
    WHEN ERROR_ID_EST_PRE THEN  
        RAISE_APPLICATION_ERROR(-20002, 'NO EXISTE ESE ID_EST'); 
END CTROL_INS_EST_PRE; 
. 
/ 
 
