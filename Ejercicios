-- TRIGGER PARA CONTROLAR LA ANOMALIA DE ELIMINACION EN PRESTAMOS. 
CREATE OR REPLACE TRIGGER CTROL_ELI_EST 
BEFORE DELETE ON ESTUDIANTES 
FOR EACH ROW 
DECLARE 
X INTEGER; 
ERROR_ELI EXCEPTION; 
BEGIN 
SELECT COUNT(ID_EST_PRE) INTO X 
FROM PRESTAMOS 
WHERE ID_EST_PRE = :OLD.ID_EST; 
IF X > 0 THEN 
RAISE ERROR_ELI; 
END IF; 
EXCEPTION 
WHEN ERROR_ELI THEN RAISE_APPLICATION_ERROR(-20003, 'ESE ESTUDIANTE TIENE PRESTAMOS'); 
END CTROL_ELI_EST; 
. 
