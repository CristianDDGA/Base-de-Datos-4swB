CREATE OR REPLACE TRIGGER CLA_PRI_EST 
BEFORE INSERT OR UPDATE OF ID_EST ON ESTUDIANTES 
FOR EACH ROW 
DECLARE 
    C INTEGER; 
    ERROR_ID_EST EXCEPTION;    
    PRAGMA AUTONOMOUS_TRANSACTION;  
BEGIN 
    -- Contamos cuántas veces existe el ID que el usuario intenta ingresar 
    SELECT COUNT(ID_EST) INTO C 
    FROM ESTUDIANTES 
    WHERE ID_EST = :NEW.ID_EST; 
 
    IF INSERTING AND C > 0 THEN 
        RAISE ERROR_ID_EST; 
         
    ELSIF UPDATING AND C > 0 AND :NEW.ID_EST != :OLD.ID_EST THEN 
        RAISE ERROR_ID_EST; 
    END IF; 
    COMMIT;  
     
EXCEPTION 
    WHEN ERROR_ID_EST THEN  
        RAISE_APPLICATION_ERROR(-20001, 'YA EXISTE ESE ID'); 
END CLA_PRI_EST; 
. 
/ 
