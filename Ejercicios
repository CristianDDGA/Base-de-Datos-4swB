CREATE OR REPLACE TRIGGER PRESTAR 
BEFORE INSERT ON PRESTAMOS 
FOR EACH ROW 
DECLARE 
D CHAR(1); 
H CHAR(1); 
ERROR_HAB EXCEPTION; 
ERROR_DIS EXCEPTION; 
  
BEGIN 
SELECT HABILITADO INTO H 
FROM ESTUDIANTES 
WHERE ID_EST = :NEW.ID_EST_PRE; 
  
IF H='N' THEN 
RAISE ERROR_HAB; 
ELSE 
SELECT DISP_LIB INTO D 
FROM LIBROS 
WHERE ID_LIB = :NEW.ID_LIB_PRE; 
IF D='N' THEN 
RAISE ERROR_DIS; 
ELSE 
UPDATE LIBROS 
SET DISP_LIB='N' 
WHERE ID_LIB = :NEW.ID_LIB_PRE; 
END IF; 
END IF; 
EXCEPTION 
WHEN ERROR_HAB THEN RAISE_APPLICATION_ERROR(-20005, 'ESTUDIANTE NO HABILITADO'); 
WHEN ERROR_DIS THEN RAISE_APPLICATION_ERROR(-20006, 'LIBRO NO DISPONIBLE'); 
END PRESTAR; 
. 
/ 
 
 
 
 
