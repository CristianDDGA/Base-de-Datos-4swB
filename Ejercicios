TRIGGER PARA DEVOLVER  
CREATE OR REPLACE TRIGGER DEVOLVER 
BEFORE UPDATE OF ID_BIB_DEV, FEC_DEV, EST_DEV ON PRESTAMOS 
FOR EACH ROW 
DECLARE 
     D NUMBER; 
    R NUMBER := 0; 
    M NUMBER; 
     
    MULTA_POR_DIA CONSTANT NUMBER := 5;  
     
    PRESTAMO_DEVUELTO EXCEPTION; 
     
BEGIN 
    IF :OLD.FEC_DEV IS NOT NULL AND :NEW.FEC_DEV IS NOT NULL THEN 
        RAISE PRESTAMO_DEVUELTO; 
    END IF; 
  
    IF :NEW.FEC_DEV IS NOT NULL AND :OLD.FEC_DEV IS NULL THEN 
         
        SELECT CAN_DIAS INTO D 
        FROM LIBROS 
        WHERE ID_LIB = :NEW.ID_LIB_PRE; 
  
        R := TRUNC(:NEW.FEC_DEV) - TRUNC(:OLD.FEC_PRE + D); 
  
        UPDATE LIBROS 
        SET  
            EST_LIB = :NEW.EST_DEV, 
            DISP_LIB = 'S'  
        WHERE  
            ID_LIB = :NEW.ID_LIB_PRE; 
  
        IF R > 0 THEN 
             
            R := R * MULTA_POR_DIA; 
  
            INSERT INTO MULTAS (NUM_MUL, FEC_MUL, NUM_PRE_CAR, VALOR_MUL, ESTADO_MUL) 
            VALUES (  
                (SELECT NVL(MAX(NUM_MUL), 0) + 1 FROM MULTAS), 
                SYSDATE, 
                :NEW.NUM_PRE, 
                M, 
                'PEND' 
            ); 
  
            UPDATE ESTUDIANTES 
            SET HABILITADO = 'N' 
            WHERE ID_EST = :NEW.ID_EST_PRE; 
             
            RAISE_APPLICATION_ERROR(-20007,  
                'Devolución registrada. Se aplicó una multa por retraso de días. y estudiante ha sido INHABILITADO.' 
            ); 
             
        END IF; 
  
    END IF; 
  
EXCEPTION 
    WHEN PRESTAMO_DEVUELTO THEN 
        RAISE_APPLICATION_ERROR(-20008, 'ERROR: El préstamo ya había sido devuelto y no puede ser modificado.'); 
    WHEN OTHERS THEN 
        RAISE_APPLICATION_ERROR(-20010, 'Error inesperado en la devolución'); 
END DEVOLVER; 
. 
/ 
 
 
 
 
 

