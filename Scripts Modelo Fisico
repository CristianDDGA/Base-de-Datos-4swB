-- 2. CREACIÓN DE TABLAS (Orden lógico por dependencias)

CREATE TABLE CENTRO_TRABAJO (
    COD_CENTRO VARCHAR2(10) PRIMARY KEY,
    NOM_CENTRO VARCHAR2(50) NOT NULL,
    POBLACION VARCHAR2(50),
    DIRECCION VARCHAR2(100)
);

CREATE TABLE DEPARTAMENTO (
    COD_DEP VARCHAR2(10) PRIMARY KEY,
    NOM_DEP VARCHAR2(50) NOT NULL,
    PRESUPUESTO NUMBER(12,2) CHECK (PRESUPUESTO >= 0),
    COD_CENTRO VARCHAR2(10),
    CONSTRAINT FK_DEP_CENTRO FOREIGN KEY (COD_CENTRO) REFERENCES CENTRO_TRABAJO(COD_CENTRO)
);

CREATE TABLE EMPLEADO (
    CI_EMP VARCHAR2(15) PRIMARY KEY,
    NOM_EMP VARCHAR2(50) NOT NULL,
    APE_EMP VARCHAR2(50) NOT NULL,
    TEL_EMP VARCHAR2(15),
    FEC_ALTA DATE DEFAULT SYSDATE,
    SALARIO NUMBER(10,2) CHECK (SALARIO > 0),
    COD_DEP VARCHAR2(10),
    CONSTRAINT FK_EMP_DEP FOREIGN KEY (COD_DEP) REFERENCES DEPARTAMENTO(COD_DEP)
);

CREATE TABLE HIJO (
    COD_HIJO VARCHAR2(10) PRIMARY KEY,
    NOM_HIJO VARCHAR2(50) NOT NULL,
    APE_HIJO VARCHAR2(50) NOT NULL,
    FEC_NAC DATE,
    CI_EMP VARCHAR2(15),
    CONSTRAINT FK_HIJO_EMP FOREIGN KEY (CI_EMP) REFERENCES EMPLEADO(CI_EMP)
);

CREATE TABLE HABILIDAD (
    COD_HAB VARCHAR2(10) PRIMARY KEY,
    DESC_HAB VARCHAR2(100) NOT NULL
);

-- Tabla intermedia para la relación N:M (Habilidades - Empleados)
CREATE TABLE EMPLEADO_HABILIDAD (
    CI_EMP VARCHAR2(15),
    COD_HAB VARCHAR2(10),
    PORCENTAJE NUMBER(5,2) CHECK (PORCENTAJE BETWEEN 0 AND 100),
    PRIMARY KEY (CI_EMP, COD_HAB),
    CONSTRAINT FK_EH_EMP FOREIGN KEY (CI_EMP) REFERENCES EMPLEADO(CI_EMP),
    CONSTRAINT FK_EH_HAB FOREIGN KEY (COD_HAB) REFERENCES HABILIDAD(COD_HAB)
);

