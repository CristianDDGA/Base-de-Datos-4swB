SELECT 
    e.NOM_EMP || ' ' || e.APE_EMP AS EMPLEADO,
    d.NOM_DEP AS DEPARTAMENTO,
    c.POBLACION AS CIUDAD_CENTRO
FROM EMPLEADO e
JOIN DEPARTAMENTO d ON e.COD_DEP = d.COD_DEP
JOIN CENTRO_TRABAJO c ON d.COD_CENTRO = c.COD_CENTRO;

SELECT 
    d.NOM_DEP,
    d.PRESUPUESTO AS PRESUPUESTO_ANUAL,
    SUM(e.SALARIO) AS NOMINA_MENSUAL,
    (SUM(e.SALARIO) * 12) AS GASTO_NOMINA_ANUAL,
    (d.PRESUPUESTO - (SUM(e.SALARIO) * 12)) AS SALDO_PRESUPUESTO
FROM DEPARTAMENTO d
LEFT JOIN EMPLEADO e ON d.COD_DEP = e.COD_DEP
GROUP BY d.NOM_DEP, d.PRESUPUESTO;

SELECT 
    e.NOM_EMP || ' ' || e.APE_EMP AS PADRE_MADRE,
    COUNT(h.COD_HIJO) AS NUMERO_HIJOS,
    FLOOR(MONTHS_BETWEEN(SYSDATE, MIN(h.FEC_NAC)) / 12) AS EDAD_HIJO_MAYOR
FROM EMPLEADO e
JOIN HIJO h ON e.CI_EMP = h.CI_EMP
GROUP BY e.NOM_EMP, e.APE_EMP;

SELECT 
    e.NOM_EMP,
    e.APE_EMP,
    h.DESC_HAB AS HABILIDAD,
    eh.PORCENTAJE AS NIVEL_DOMINIO
FROM EMPLEADO e
JOIN EMPLEADO_HABILIDAD eh ON e.CI_EMP = eh.CI_EMP
JOIN HABILIDAD h ON eh.COD_HAB = h.COD_HAB
WHERE h.DESC_HAB = 'Oracle SQL' AND eh.PORCENTAJE > 80
ORDER BY eh.PORCENTAJE DESC;
