SELECT 
    cp.NUM_COMPRA,
    c.NOM_CLI || ' ' || c.APE_CLI AS CLIENTE,
    p.DESC_PROD,
    p.PRE_PROD AS PRECIO,
    cp.FEC_COM,
    cp.FOR_PAGO
FROM COMPRA_TIENDA cp
JOIN CLIENTE_TIENDA c ON cp.COD_CLI = c.COD_CLI
JOIN PROD_TIENDA p ON cp.COD_PROD = p.COD_PROD
ORDER BY cp.NUM_COMPRA, cp.FEC_COM DESC;

SELECT 
    cp.NUM_COMPRA,
    c.NOM_CLI || ' ' || c.APE_CLI AS CLIENTE,
    SUM(p.PRE_PROD) AS TOTAL_FACTURADO
FROM COMPRA_TIENDA cp
JOIN CLIENTE_TIENDA c ON cp.COD_CLI = c.COD_CLI
JOIN PROD_TIENDA p ON cp.COD_PROD = p.COD_PROD
GROUP BY cp.NUM_COMPRA, c.NOM_CLI, c.APE_CLI
ORDER BY cp.NUM_COMPRA;

SELECT 
    pv.NOM_PROV || ' ' || pv.APE_PROV AS PROVEEDOR,
    pv.PROVINCIA_PROV AS PROVINCIA,
    SUM(e.CANTIDAD_ENT * e.PRE_ADQ) AS TOTAL_INVERTIDO
FROM PROV_TIENDA pv
JOIN ENTREGA_TIENDA e ON pv.COD_PROV = e.COD_PROV
GROUP BY pv.NOM_PROV, pv.APE_PROV, pv.PROVINCIA_PROV
ORDER BY TOTAL_INVERTIDO DESC;

SELECT 
    p.DESC_PROD,
    e.PRE_ADQ AS COSTO_PROVEEDOR,
    p.PRE_PROD AS PRECIO_VENTA_PUBLICO,
    (p.PRE_PROD - e.PRE_ADQ) AS MARGEN_GANANCIA,
    ROUND(((p.PRE_PROD - e.PRE_ADQ) / e.PRE_ADQ) * 100, 2) AS PORCENTAJE_RENTABILIDAD
FROM PROD_TIENDA p
JOIN ENTREGA_TIENDA e ON p.COD_PROD = e.COD_PROD;

